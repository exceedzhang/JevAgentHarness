# litellm_jah (jevgym deployment) environment.
# Copy this file to `.env` (same directory) and fill in real values.
# `.env` is git-ignored (see .gitignore) — NEVER commit real keys; commit only this `.env.example`.

# The LiteLLM proxy master key. MUST be set explicitly and persistently to a strong value.
# If unset, LiteLLM auto-generates an ephemeral key that changes on every container restart
# (breaking any client that cached it). Use a long random string, e.g.:
#   python -c "import secrets; print('jah-'+secrets.token_hex(16))"
LITELLM_MASTER_KEY=CHANGE_ME_strong_random_key

# The 27B decision-model / worker (vllm OpenAI-compatible) API key. Default sk-1234.
DECISION_API_KEY=sk-1234

# Optional: set to 1 to enable JAH_DEBUG / JAH_DECISION_DEBUG logging (off by default).
#JAH_DEBUG=
